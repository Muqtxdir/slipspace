<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="slipspace">
  <enum id="com.muqtxdir.slipspace.datetime.ClockFormat">
    <value nick="24h" value="0"/>
    <value nick="12h" value="1"/>
  </enum>
  <schema id="com.muqtxdir.slipspace" path="/com/muqtxdir/slipspace/">
	</schema>
  <schema id="com.muqtxdir.slipspace.datetime" path="/com/muqtxdir/slipspace/datetime/">
    <key name="time-format" enum="com.muqtxdir.slipspace.datetime.ClockFormat">
      <default>'24h'</default>
      <summary>Time format</summary>
      <description>
				Whether the clock shows the time in 24-hour or 12-hour
				format.
			</description>
    </key>
    <key name="timezone" type="s">
      <default>''</default>
      <summary>The last known system timezone</summary>
      <description>Current system timezone set and used by the application.</description>
    </key>
  </schema>
  <schema id="com.muqtxdir.slipspace.battery" path="/com/muqtxdir/slipspace/battery/">
    <key name="show-percentage" type="b">
      <default>false</default>
      <summary>Show the battery percentage</summary>
      <description>
				Whether the panel shows the charge percentage next to the
				battery icon.
			</description>
    </key>
  </schema>
</schemalist>
