import os
import sys
import signal
import locale
import gettext

VERSION = '@VERSION@'
pkgdatadir = '@pkgdatadir@'
localedir = '@localedir@'

sys.path.insert(1, pkgdatadir)
signal.signal(signal.SIGINT, signal.SIG_DFL)
locale.bindtextdomain('slipspace', localedir)
locale.textdomain('slipspace')
gettext.bindtextdomain('slipspace', localedir)
gettext.textdomain('slipspace')

if __name__ == '__main__':
    import gi

    from gi.repository import Gio
    resource = Gio.Resource.load(os.path.join(pkgdatadir, 'slipspace.gresource'))
    resource._register()

    from slipspace import main
    sys.exit(main.main(VERSION))
