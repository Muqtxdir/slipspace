<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <template class="QuickSettingsOverlay" parent="AdwBin">
    <property name="child">
      <object class="AdwOverlaySplitView" id="split_view">
        <property name="sidebar-position">end</property>
        <property name="max-sidebar-width">350</property>
        <property name="collapsed">True</property>
        <property name="show-sidebar">False</property>
        <property name="sidebar">
          <object class="AdwToolbarView">
            <property name="content">
              <object class="AdwPreferencesPage">
                <child>
                  <object class="AdwPreferencesGroup">
                    <property name="title" translatable="yes">Connectivity</property>
                    <child>
                      <object class="WifiRow"/>
                    </child>
                    <child>
                      <object class="EthernetRow"/>
                    </child>
                    <child>
                      <object class="BluetoothRow"/>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwPreferencesGroup">
                    <property name="title" translatable="yes">Brightness</property>
                    <child>
                      <object class="BrightnessRow"/>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwPreferencesGroup">
                    <property name="title" translatable="yes">Audio</property>
                    <child>
                      <object class="SpeakerRow"/>
                    </child>
                    <child>
                      <object class="MicrophoneRow"/>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwPreferencesGroup">
                    <property name="title" translatable="yes">Power</property>
                    <child>
                      <object class="PowerProfilesRow"/>
                    </child>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
