<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <template class="MicrophoneRow" parent="AdwPreferencesRow">
    <property name="child">
      <object class="GtkBox">
        <property name="spacing">6</property>
        <property name="margin-start">12</property>
        <property name="margin-end">12</property>
        <property name="margin-top">12</property>
        <property name="margin-bottom">12</property>
        <child>
          <object class="GtkButton">
            <property name="valign">center</property>
            <property name="icon-name" bind-source="MicrophoneRow" bind-property="icon-name" bind-flags="sync-create"/>
            <binding name="tooltip-text">
              <closure type="gchararray" function="_get_mute_tooltip">
                <lookup name="mute" type="MicrophoneRow"/>
              </closure>
            </binding>
            <signal name="clicked" handler="_on_mute_button_clicked" swapped="no"/>
          </object>
        </child>
        <child>
          <object class="GtkScale">
            <property name="hexpand">True</property>
            <property name="valign">center</property>
            <property name="draw-value">False</property>
            <binding name="sensitive">
              <closure type="gboolean" function="_get_scale_sensitive">
                <lookup name="mute" type="MicrophoneRow"/>
              </closure>
            </binding>
            <property name="adjustment">
              <object class="GtkAdjustment">
                <property name="lower">0</property>
                <property name="upper">1</property>
                <property name="step-increment">0.05</property>
                <property name="page-increment">0.1</property>
                <property name="value" bind-source="MicrophoneRow" bind-property="volume" bind-flags="sync-create|bidirectional"/>
              </object>
            </property>
          </object>
        </child>
      </object>
    </property>
  </template>
</interface>
