<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <template class="AppearanceRow" parent="AdwPreferencesRow">
    <property name="accessible-role">group</property>
    <property name="activatable">False</property>
    <property name="focusable">False</property>
    <property name="child">
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkGrid">
            <property name="halign">center</property>
            <property name="column-homogeneous">True</property>
            <property name="column-spacing">24</property>
            <property name="row-spacing">12</property>
            <property name="margin-start">12</property>
            <property name="margin-end">12</property>
            <property name="margin-top">18</property>
            <property name="margin-bottom">12</property>
            <child>
              <object class="GtkToggleButton" id="default_tile">
                <property name="halign">center</property>
                <property name="width-request">128</property>
                <property name="height-request">128</property>
                <property name="child">
                  <object class="GtkImage">
                    <property name="icon-name">com.muqtxdir.slipspace.window-symbolic</property>
                    <property name="pixel-size">32</property>
                  </object>
                </property>
                <style>
                  <class name="flat"/>
                  <class name="style-preview-default"/>
                </style>
                <layout>
                  <property name="column">0</property>
                  <property name="row">0</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label" translatable="yes">_Default</property>
                <property name="use-underline">True</property>
                <property name="mnemonic-widget">default_tile</property>
                <layout>
                  <property name="column">0</property>
                  <property name="row">1</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkToggleButton" id="dark_tile">
                <property name="group">default_tile</property>
                <property name="halign">center</property>
                <property name="width-request">128</property>
                <property name="height-request">128</property>
                <property name="child">
                  <object class="GtkImage">
                    <property name="icon-name">com.muqtxdir.slipspace.window-symbolic</property>
                    <property name="pixel-size">32</property>
                  </object>
                </property>
                <style>
                  <class name="flat"/>
                  <class name="style-preview-dark"/>
                </style>
                <layout>
                  <property name="column">1</property>
                  <property name="row">0</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label" translatable="yes">_Dark</property>
                <property name="use-underline">True</property>
                <property name="mnemonic-widget">dark_tile</property>
                <layout>
                  <property name="column">1</property>
                  <property name="row">1</property>
                </layout>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkSeparator"/>
        </child>
        <child>
          <object class="AdwWrapBox" id="swatches">
            <property name="align">0.5</property>
            <property name="child-spacing">12</property>
            <property name="line-spacing">12</property>
            <property name="margin-top">12</property>
            <property name="margin-bottom">12</property>
            <property name="margin-start">12</property>
            <property name="margin-end">12</property>
          </object>
        </child>
      </object>
    </property>
  </template>
</interface>
