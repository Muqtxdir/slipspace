<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <template class="BluetoothRow" parent="AdwActionRow">
    <property name="title" translatable="yes">Bluetooth</property>
    <property name="activatable-widget">bluetooth_switch</property>
    <child type="prefix">
      <object class="GtkImage">
        <property name="icon-name" bind-source="BluetoothRow" bind-property="icon-name" bind-flags="sync-create"/>
      </object>
    </child>
    <child type="suffix">
      <object class="GtkSwitch" id="bluetooth_switch">
        <property name="valign">center</property>
        <property name="active" bind-source="BluetoothRow" bind-property="powered" bind-flags="sync-create|bidirectional"/>
      </object>
    </child>
  </template>
</interface>
