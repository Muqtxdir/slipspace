<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <template class="StyleRow" parent="AdwActionRow">
    <property name="title" translatable="yes">Dark Mode</property>
    <property name="activatable-widget">style_switch</property>
    <child type="prefix">
      <object class="GtkImage">
        <property name="icon-name">weather-clear-night-symbolic</property>
      </object>
    </child>
    <child type="suffix">
      <object class="GtkSwitch" id="style_switch">
        <property name="valign">center</property>
        <property name="active" bind-source="StyleRow" bind-property="prefer-dark" bind-flags="sync-create|bidirectional"/>
      </object>
    </child>
  </template>
</interface>
